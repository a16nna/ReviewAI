# Copy to backend/.env (local; loaded automatically at startup, real environment variables win) or ./.env (docker compose). Placeholders only — never commit real values.
DATABASE_URL=sqlite:///./reviewai.db
# Origins allowed to call the API (exact match; localhost and 127.0.0.1 are different origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=30
# Delete reviews older than N days (0 = keep forever)
RETENTION_DAYS=0

# --- Google Gemini (leave GEMINI_API_KEY unset for labelled demo/mock mode) ---
# Create a key at https://aistudio.google.com/apikey. Backend-only: never put it in frontend code or VITE_* variables.
GEMINI_API_KEY=
# Model id sent to the Gemini API. Default if unset: gemini-3.1-flash-lite. Check https://ai.google.dev/gemini-api/docs/models
# for models that are currently available to your key and support structured output.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- GitHub OAuth App (callback: http://localhost:5173/api/github/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=public_repo
GITHUB_REDIRECT_URI=http://localhost:5173/api/github/callback
FRONTEND_URL=http://localhost:5173
# Only for GitHub Enterprise / testing against a stand-in server (defaults shown):
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_URL=https://github.com

# --- Analyzer locations (only if the tools are installed but not on PATH) ---
# CPPCHECK_PATH=C:\Program Files\Cppcheck\cppcheck.exe
# JAVA_EXE=C:\Program Files\Eclipse Adoptium\jre-21\bin\java.exe

# --- Sessions / cookies ---
# Stable Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())").
# If unset a random key is generated at startup and GitHub sessions are lost on restart.
SESSION_KEY=
# Set true when served over HTTPS (adds the Secure flag to cookies)
COOKIE_SECURE=true

# --- Optional GitHub webhook (PR opened/synchronize/reopened -> automatic review, never auto-comments) ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT with read-only "Pull requests" + "Contents" on the repos to watch
GITHUB_WEBHOOK_TOKEN=
